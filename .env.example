# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp & Contact Configuration
# Ganti dengan nomor WhatsApp resmi (format internasional tanpa tanda +, contoh: 6281234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=6285795093442
NEXT_PUBLIC_CONTACT_EMAIL=info@kenalibakat.id

# Supabase Configuration
# Dapatkan dari Project Settings > API di dashboard Supabase Anda.
# Jika belum diisi, formulir pendaftaran akan menampilkan status belum terhubung dan mengarahkan ke WhatsApp.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
